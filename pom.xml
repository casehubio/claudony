<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.casehub</groupId>
    <artifactId>casehub-parent</artifactId>
    <version>0.4-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <groupId>io.casehub</groupId>
  <artifactId>casehub-claudony-parent</artifactId>
  <version>0.4-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>core</module>
    <module>casehub</module>
    <module>testing</module>
    <module>app</module>
  </modules>

  <properties>
    <!-- Override parent's Quarkus version — claudony needs migration work before upgrading -->
    <quarkus.platform.version>3.32.2</quarkus.platform.version>
    <!-- Parent BOM sets 7.35.3.Final which is not on Maven Central (Red Hat release);
         pin to 7.25.1.Final until parent resolves the repository gap -->
    <serverlessworkflow.version>7.25.1.Final</serverlessworkflow.version>
    <casehub-packages.phase>initialize</casehub-packages.phase>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Quarkus BOM — uses local override version (3.32.2) -->
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- jackson-jq convergence: engine-common 1.6.0, quarkus-flow 1.6.5, quarkiverse-jackson-jq 1.6.2 -->
      <dependency>
        <groupId>net.thisptr</groupId>
        <artifactId>jackson-jq</artifactId>
        <version>1.6.5</version>
      </dependency>
    </dependencies>
  </dependencyManagement>


  <repositories>
    <repository>
      <id>github</id>
      <name>casehubio GitHub Packages</name>
      <url>https://maven.pkg.github.com/casehubio/*</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>casehubio GitHub Packages</name>
      <url>https://maven.pkg.github.com/casehubio/claudony</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>casehubio GitHub Packages</name>
      <url>https://maven.pkg.github.com/casehubio/claudony</url>
      <uniqueVersion>false</uniqueVersion>
    </snapshotRepository>
  </distributionManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.smallrye</groupId>
          <artifactId>jandex-maven-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
